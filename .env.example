# ==============================================================================
# NUVARO AGRO GLOBAL - ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# --- 1. Backend Server Settings ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- 2. MongoDB Database Configuration ---
# Provide your MongoDB Atlas Connection String or local MongoDB URI:
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nuvaro_agro

# --- 3. Cloudinary CDN Image Uploads Configuration ---
# Get these from your Cloudinary Console (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=nuvaro_agro/products

# --- 4. Admin Login & Notification Settings ---
ADMIN_EMAIL=admin@nuvaroagro.com
ADMIN_PASSWORD=Nuvaro@2026
ADMIN_PHONE=+918087405952

# --- 5. Frontend Client Settings (Vite prefixed) ---
VITE_API_BASE_URL=/api
VITE_WHATSAPP_NUMBER=918087405952
VITE_COMPANY_EMAIL=yogesh@nuvaroagro.com
